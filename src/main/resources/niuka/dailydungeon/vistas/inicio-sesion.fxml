<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="niuka.dailydungeon.presentacion.controlador.ControladorInicioSesion">
    <VBox styleClass="formulario" spacing="8.0" maxWidth="300.0">
        <Label text="DailyDungeon" styleClass="titulo"/>
        <Label text="Usuario"/>
        <TextField fx:id="campoUsuario"/>
        <Label text="Contraseña"/>
        <PasswordField fx:id="campoContrasena"/>
        <Button text="Iniciar sesión" defaultButton="true" maxWidth="Infinity" onAction="#iniciarSesion"/>
        <Hyperlink text="¿No tenés cuenta? Registrate" onAction="#irARegistro"/>
    </VBox>
</VBox>
