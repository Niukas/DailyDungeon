<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="niuka.dailydungeon.presentacion.controlador.ControladorFormularioMision">
    <VBox styleClass="formulario" spacing="8.0" maxWidth="400.0">
        <Label fx:id="etiquetaEncabezado" styleClass="titulo"/>
        <Label text="Título"/>
        <TextField fx:id="campoTitulo"/>
        <Label text="Descripción (opcional)"/>
        <TextArea fx:id="campoDescripcion" prefRowCount="4" wrapText="true"/>
        <Label text="Fecha límite (opcional)"/>
        <DatePicker fx:id="campoFecha" maxWidth="Infinity"/>
        <Label text="Dificultad"/>
        <ComboBox fx:id="comboDificultad" maxWidth="Infinity"/>
        <Label text="Prioridad"/>
        <ComboBox fx:id="comboPrioridad" maxWidth="Infinity"/>
        <HBox spacing="8.0" alignment="CENTER_RIGHT">
            <Button text="Cancelar" cancelButton="true" onAction="#cancelar"/>
            <Button text="Guardar" defaultButton="true" onAction="#guardar"/>
        </HBox>
    </VBox>
</VBox>
